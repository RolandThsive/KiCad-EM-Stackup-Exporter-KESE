     list(APPEND MFEM_OPTIONS
       "-DParMETIS_LIBRARIES=${PARMETIS_LIBRARIES}$<SEMICOLON>${METIS_LIBRARIES}"
       "-DParMETIS_INCLUDE_DIRS=${CMAKE_INSTALL_PREFIX}/include"
@@ -226,6 +226,14 @@ if(PALACE_BUILD_EXTERNAL_DEPS)
     )
   endif()
 
+  # HYPRE is built with the external BLAS/LAPACK (see ExternalHYPRE.cmake). Without a direct solver, nothing else
+  # puts them on MFEM's link line, so they are passed with HYPRE
+  if(NOT "${BLAS_LAPACK_LIBRARIES}" STREQUAL "")
+    list(APPEND MFEM_OPTIONS
+      "-DHYPRE_REQUIRED_LIBRARIES=${BLAS_LAPACK_LIBRARIES}"
+    )
+  endif()
+
   # Need to pass gfortran (or similar) dependency to C++ linker for MFEM link line
   if(PALACE_WITH_STRUMPACK OR PALACE_WITH_MUMPS)
     if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
@@ -333,7 +341,7 @@ Intel C++ compiler for MUMPS and STRUMPACK dependencies")
 
   # Configure MUMPS
