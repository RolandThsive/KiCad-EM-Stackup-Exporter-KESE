(kicad_pcb (version 20221018) (generator pcbnew)
  (general (thickness 1.6))
  (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (36 "B.SilkS" user) (37 "F.SilkS" user)
          (38 "B.Mask" user) (39 "F.Mask" user) (44 "Edge.Cuts" user) (49 "F.Fab" user))
  (setup
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen") (color "White"))
      (layer "F.Mask" (type "Top Solder Mask") (color "Blue") (thickness 0.02))
      (layer "F.Cu" (type "copper") (thickness 0.07))
      (layer "dielectric 1" (type "core") (thickness 1.46))
      (layer "B.Cu" (type "copper") (thickness 0.07))
      (layer "B.Mask" (type "Bottom Solder Mask") (thickness 0.02)))
    (pad_to_mask_clearance 0.05)
    (pcbplotparams (viasonmask false) (subtractmaskfromsilk true)))
  (net 0 "")
  (gr_line (start 100 100) (end 130 100) (stroke (width 0.1) (type solid)) (layer "Edge.Cuts"))
  (gr_arc (start 130 100) (mid 133.535534 101.464466) (end 135 105) (stroke (width 0.1) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 135 105) (end 135 120) (stroke (width 0.1) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 135 120) (end 100 120) (stroke (width 0.1) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 100 120) (end 100 100) (stroke (width 0.1) (type solid)) (layer "Edge.Cuts"))
  (gr_circle (center 128 113) (end 129.5 113) (stroke (width 0.1) (type solid)) (fill none) (layer "Edge.Cuts"))
  (gr_rect (start 102 102) (end 106 104) (stroke (width 0) (type solid)) (fill solid) (layer "F.Mask"))
  (gr_line (start 102 117) (end 120 117) (stroke (width 0.3) (type solid)) (layer "F.SilkS"))
  (gr_circle (center 110 110) (end 113 110) (stroke (width 0.2) (type solid)) (fill none) (layer "F.SilkS"))
  (gr_text "HELLO" (at 110 105) (layer "F.SilkS") (effects (font (size 1 1))))
  (gr_line (start 100 100) (end 110 110) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (segment (start 104 110) (end 116 110) (width 0.5) (layer "F.Cu") (net 0))
  (arc (start 116 110) (mid 118.12132 110.87868) (end 119 113) (width 0.5) (layer "F.Cu") (net 0))
  (via (at 104 110) (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 0))
  (zone (net 0) (net_name "") (layer "B.Cu") (hatch edge 0.5)
    (polygon (pts (xy 101 101) (xy 120 101) (xy 120 108) (xy 101 108)))
    (filled_polygon (layer "B.Cu") (pts (xy 101.5 101.5) (xy 119.5 101.5) (xy 119.5 107.5) (xy 101.5 107.5))))
  (footprint "TestLib:Conn" (layer "F.Cu") (at 125 106 90)
    (fp_text reference "J1" (at 0 -3) (layer "F.SilkS") (effects (font (size 1 1))))
    (fp_rect (start -1.5 -3) (end 1.5 3) (stroke (width 0.15) (type solid)) (fill none) (layer "F.SilkS"))
    (pad "1" thru_hole rect (at 0 -1.27 90) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
    (pad "2" thru_hole oval (at 0 1.27 90) (size 1.7 1.2) (drill oval 1.0 0.6) (layers "*.Cu" "*.Mask"))
    (model "${KICAD7_3DMODEL_DIR}/x.wrl"))
  (footprint "TestLib:R0805" (layer "F.Cu") (at 112 114 0)
    (pad "1" smd roundrect (at -1 0) (size 1 1.3) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
    (pad "2" smd roundrect (at 1 0) (size 1 1.3) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25) (solder_mask_margin 0.2)))
  (footprint "TestLib:Hole" (layer "F.Cu") (at 104 116)
    (pad "" np_thru_hole circle (at 0 0) (size 2.2 2.2) (drill 2.2) (layers "*.Cu" "*.Mask")))
)
